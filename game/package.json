{
  "name": "fmu-m29-world-advance-transactional",
  "private": true,
  "version": "0.29.30",
  "license": "GPL-3.0-only",
  "description": "M29: Rust World transactional day advance driver with mandatory engine hooks and safe .bfn checkpoints; Rust parity unverified",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js dist/tests/m30/*.test.js",
    "audit": "node tools/inventory.mjs",
    "serve": "python3 -m http.server 8000 --directory public/fmu-m24",
    "m20:verify": "python3 tools/port_static_tables.py --check && python3 tools/verify_m20.py",
    "m21:verify": "python3 tools/verify_m21_sources.py && npm test",
    "m23:tests": "npm run build && node --test dist/tests/m23_app_*.test.js",
    "m23:audit": "python3 tools/m23_audit.py --check",
    "m24:bundle": "npm run build && node tools/m24_bundle.js",
    "m24:two-seasons": "npm run build && node tools/m24_advance_career.js 2",
    "m25:tests": "npm run build && node --test dist/tests/m25_*.test.js",
    "m25:bundle": "npm run build && node tools/m24_bundle.js",
    "m25:browser-qa": "python3 tools/m25_browser_qa.py",
    "m25:audit": "python3 tools/m25_audit.py --check",
    "m26:tests": "npm run build && node --test dist/tests/m26_*.test.js",
    "m26:inspect": "node dist/src/m26/diagnostics/cli.js",
    "m26:smoke": "npm run build && node dist/src/m26/diagnostics/cli.js demo-smoke 36 2026",
    "m27:tests": "npm run build && node --test dist/tests/m27_*.test.js",
    "m27:world": "npm run build && node dist/src/m27/persistence/world_cli.js",
    "m27:audit": "python3 tools/m27_generate_world_schema.py --check && python3 tools/m27_generate_barrels.py --check && python3 tools/m27_audit.py",
    "m28:tests": "npm run build && node --test dist/tests/m28_*.test.js",
    "m28:world": "npm run build && node dist/src/m28/world_cli.js",
    "m28:audit": "npm run m27:audit",
    "m29:tests": "npm run build && node --test dist/tests/m29_world_advance.test.js",
    "m29:inspect": "npm run build && node dist/src/m29_world_cli.js",
    "m30:tests": "npm run build && node --test dist/tests/m30/*.test.js",
    "m29m30:tests": "npm test"
  }
}
